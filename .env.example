APP_NAME="Camilo_nc"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Credenciales de la API de Twitch (Helix) para detectar el estado LIVE del badge.
# Consíguelas en https://dev.twitch.tv/console/apps — mientras tanto, deja los
# placeholders: el script no hará ningún fetch y el badge quedará oculto.
VITE_TWITCH_CLIENT_ID=tu_client_id_aqui
VITE_TWITCH_TOKEN=tu_token_aqui

# Credenciales de la API de Riot Games para mostrar datos reales de LoL.
RIOT_API_KEY=tu_riot_api_key_aqui
RIOT_REGION=la1
RIOT_REGIONAL=americas
RIOT_GAME_NAME="Tu Nombre"
RIOT_TAG_LINE=TAG

# Credenciales de la Steam Web API para mostrar los juegos más jugados.
# Consíguelas en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=tu_steam_api_key_aqui
STEAM_ID=tu_steam_id_aqui
